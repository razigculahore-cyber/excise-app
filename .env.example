# Copy to .env privately. Never commit credentials.
# Supabase Connect: Session pooler (IPv4, port 5432), or Direct when supported.
# Include sslmode=require or verify-full with the CA certificate.
DATABASE_URL=
# Optional direct URI used for schema migrations and imports:
DATABASE_URL_UNPOOLED=
SECRET_KEY=
HTTPS=0
ALLOW_SIGNUP=0
APP_TIMEZONE=Asia/Karachi
# Production: APP_ENV=production, HTTPS=1, strong SECRET_KEY (32+ characters).
# Local disposable PostgreSQL ONLY; database name must end _test:
TEST_DATABASE_URL=
