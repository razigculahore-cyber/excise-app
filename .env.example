# Copy this file to .env and fill in the values. .env is never committed.
# On your computer, use the Neon *dev* branch only. The production branch's
# connection string goes only into Vercel's Environment Variables.

# Neon dev branch, pooled connection string (its host contains "-pooler")
DATABASE_URL=
# Neon dev branch, direct connection string (no "-pooler"); used by init-db and migrations
DATABASE_URL_UNPOOLED=
# Tests: Neon dev branch, direct connection string. Each run works in its own
# throwaway schema and drops it afterwards, so dev data is never touched.
TEST_DATABASE_URL=

# Optional on your computer (the defaults are shown)
# APP_ENV=development
# APP_TIMEZONE=Asia/Karachi
# ALLOW_SIGNUP=1
